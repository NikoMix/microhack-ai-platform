# =============================================================================
# microhack-ai-platform — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# =============================================================================

# ----- Provider selection: github_models | azure_openai | azure_ai_foundry ---
# The whole app is provider-agnostic. Switch providers by changing this value
# only — no application code changes. This is what powers the migration lab.
INFERENCE_PROVIDER=github_models

# Logical model "role" names → mapped to a concrete deployment per provider.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# 1) GitHub Models  (ZERO-COST default — no Azure subscription required)
#    Create a fine-grained PAT with "Models" read access at
#    https://github.com/settings/personal-access-tokens
# ---------------------------------------------------------------------------
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# 2) Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave AZURE_OPENAI_API_KEY blank to use Entra ID (DefaultAzureCredential) —
# the recommended, key-less path. Only set a key for local quick-starts.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---------------------------------------------------------------------------
# 3) Azure AI Foundry  (project + Agent Service)
#    Endpoint looks like https://<resource>.services.ai.azure.com/api/projects/<project>
#    Uses DefaultAzureCredential — run `az login` first. No keys.
# ---------------------------------------------------------------------------
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_FOUNDRY_AGENT_ID=

# ---------------------------------------------------------------------------
# Retrieval (RAG): azure_ai_search | local
#   local  → in-memory numpy vector store (no Azure, great for Lab 4 offline)
#   azure_ai_search → Azure AI Search (production, Lab 5)
# ---------------------------------------------------------------------------
RETRIEVAL_BACKEND=local
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=contoso-knowledge
AZURE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Responsible AI / guardrails (optional extras)
# ---------------------------------------------------------------------------
CONTENT_SAFETY_ENDPOINT=
ENABLE_PROMPT_SHIELDS=true

# ---------------------------------------------------------------------------
# Telemetry (optional extra) — Azure Monitor / Application Insights
# ---------------------------------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=contoso-ai-assistant
